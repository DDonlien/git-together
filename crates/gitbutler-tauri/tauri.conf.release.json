{
	"productName": "GitTogether",
	"identifier": "com.gittogether.client",
	"build": {
		"beforeBuildCommand": "bash ./crates/gitbutler-tauri/tauri-before-build-command.sh production"
	},
	"bundle": {
		"active": true,
		"icon": [
			"icons/release/32x32.png",
			"icons/release/128x128.png",
			"icons/release/128x128@2x.png",
			"icons/release/icon.icns",
			"icons/release/icon.ico"
		],
		"externalBin": ["to be replaced by `release.sh`"]
	},
	"plugins": {
		"deep-link": {
			"desktop": {
				"schemes": ["gittogether"]
			}
		}
	}
}
