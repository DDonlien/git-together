{
  "name": "gittogether-standalone",
  "version": "0.38.10",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:ui": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "dev:rust": "tsx scripts/dev.ts",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/update-model.test.ts tests/desktop-package.test.ts tests/desktop-release.test.ts tests/presence-avatar-color.test.ts",
    "desktop": "tauri dev",
    "tauri": "tauri",
    "check:rust": "cargo check --manifest-path src-tauri/Cargo.toml --locked",
    "icons": "tsx scripts/generate-icons.ts",
    "package:desktop": "tsx scripts/package-desktop.ts",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "package:windows": "tsx scripts/package-windows.ts"
  },
  "dependencies": {
    "@fontsource/roboto": "5.3.0",
    "@lit/react": "1.0.8",
    "@material/web": "2.5.0",
    "@phosphor-icons/react": "2.1.10",
    "@tauri-apps/api": "2.12.3",
    "@tauri-apps/plugin-dialog": "2.8.2",
    "@vitejs/plugin-react": "5.0.4",
    "open-glass-ui": "0.4.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
