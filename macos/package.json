{
  "name": "gittogether-standalone",
  "version": "0.37.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../scripts/desktop.mjs dev",
    "dev:ui": "node ../scripts/desktop.mjs dev",
    "dev:rust": "node ../scripts/desktop.mjs dev",
    "build": "vite build",
    "preview": "node ../scripts/desktop.mjs dev",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "desktop": "node ../scripts/desktop.mjs dev",
    "tauri": "node ../scripts/desktop.mjs dev",
    "check:rust": "cargo check --manifest-path ../desktop/gittogether-presence/Cargo.toml --locked",
    "icons": "tsx scripts/generate-icons.ts",
    "package:desktop": "node ../scripts/desktop.mjs package",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "package:windows": "node ../scripts/desktop.mjs package"
  },
  "dependencies": {
    "@fontsource/roboto": "5.3.0",
    "@lit/react": "1.0.8",
    "@material/web": "2.5.0",
    "@phosphor-icons/react": "2.1.10",
    "@tauri-apps/api": "2.12.3",
    "@tauri-apps/plugin-dialog": "2.8.2",
    "@vitejs/plugin-react": "5.0.4",
    "open-glass-ui": "0.4.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "@electron/osx-sign": "2.7.1",
    "@tauri-apps/cli": "2.12.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "electron": "^39.2.7",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "electron-updater": "6.8.9"
  },
  "engines": {
    "node": ">=22"
  }
}
